# ============================================================
# HelloAgents - 环境变量示例
# 复制本文件为 .env 并填入你自己的值：cp .env.example .env
# ============================================================

# ── 必填：LLM 连接（兼容 OpenAI 及所有 OpenAI 格式接口：DeepSeek / Qwen / Kimi / 智谱 / Ollama 等）──
LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60

# ── 可选：联网搜索（SerpAPI）──
# SERPAPI_API_KEY=

# ── 可选：向量数据库（Qdrant，用于记忆/RAG）──
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_COLLECTION=
# QDRANT_VECTOR_SIZE=
# QDRANT_DISTANCE=
# QDRANT_TIMEOUT=

# ── 可选：Embedding 模型 ──
# EMBED_MODEL_TYPE=
# EMBED_MODEL_NAME=
# EMBED_API_KEY=
# EMBED_BASE_URL=

# ── 可选：GitHub / HuggingFace ──
# GITHUB_PERSONAL_ACCESS_TOKEN=
# HF_TOKEN=
